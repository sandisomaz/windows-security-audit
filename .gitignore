*.tmp
*.log
*.bak
Full_Project_Context.txt
codebase_context.txt
*codebase*.txt
* codebase.txt
Export-Codebase.ps1
export_codebase.py

# User-Specific Config Overrides & Secrets
*_local.psd1
.env
.env.*
*.key
*.pem
*.secret

# OS System Files
Thumbs.db
desktop.ini
.DS_Store

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp