# EditorConfig configuration for Windows Security Audit Framework
root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4

[*.{html,css,js,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
